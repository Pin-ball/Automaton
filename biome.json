{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/dist", "!**/.untracked", "!**/.claude", "!public", "!**/*.gen.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        }
      },
      "nursery": {
        "useTailwindSortedClasses": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/engine/gl/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-*",
                      "react/**",
                      "zustand",
                      "zustand/**",
                      "i18next",
                      "i18next-*",
                      "@src/**",
                      "!@src/engine/**"
                    ],
                    "message": "The engine stays independent from React, stores and the app: import only from src/engine or GPU libraries."
                  }
                ]
              }
            }
          },
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["src/engine/**", "!src/engine/gl/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "react",
                      "react-*",
                      "react/**",
                      "zustand",
                      "zustand/**",
                      "i18next",
                      "i18next-*",
                      "@src/**",
                      "!@src/engine/**"
                    ],
                    "message": "The engine stays independent from React, stores and the app: import only from src/engine or GPU libraries."
                  },
                  {
                    "group": ["twgl.js"],
                    "message": "twgl.js stays behind src/engine/gl: use or extend the helpers there."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@src/engine/**", "!@src/engine/index.ts"],
                    "message": "Use the engine through its public entry point, @src/engine/index.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
